    "Scan the QR code with your iPhone camera. The phone and Apple TV must be on the same Wi-Fi network.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امسح رمز QR بكاميرا iPhone. يجب أن يكون الهاتف وApple TV على شبكة Wi-Fi نفسها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne den QR-Code mit der Kamera deines iPhone. Telefon und Apple TV müssen im selben Wi-Fi-Netzwerk sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea el código QR con la cámara de tu iPhone. El teléfono y el Apple TV deben estar en la misma red Wi-Fi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne le code QR avec l’appareil photo de ton iPhone. Le téléphone et l’Apple TV doivent être sur le même réseau Wi-Fi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने iPhone कैमरे से QR कोड स्कैन करें। फ़ोन और Apple TV एक ही Wi-Fi नेटवर्क पर होने चाहिए।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneのカメラでQRコードをスキャンしてください。iPhoneとApple TVは同じWi-Fiネットワークに接続されている必要があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escaneie o código QR com a câmera do seu iPhone. O celular e a Apple TV precisam estar na mesma rede Wi-Fi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсканируй QR-код камерой iPhone. Телефон и Apple TV должны быть в одной сети Wi-Fi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "QR kodu iPhone kameranla tara. Telefon ve Apple TV aynı Wi-Fi ağında olmalı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 iPhone 相机扫描 QR 码。手机和 Apple TV 必须连接到同一 Wi-Fi 网络。"
          }
        }
      }
    },
