    "Hold the select button and choose Reload from the menu to try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطولًا على زر التحديد واختر «إعادة تحميل» من القائمة للمحاولة مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte die Auswahltaste gedrückt und wähle im Menü „Neu laden“, um es erneut zu versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado el botón de selección y elige Recargar en el menú para volver a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens le bouton de sélection et choisis Actualiser dans le menu pour réessayer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फिर से कोशिश करने के लिए सिलेक्ट बटन दबाए रखें और मेनू से रीलोड चुनें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択ボタンを長押しし、メニューから「再読み込み」を選択してもう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha pressionado o botão de seleção e escolha Recarregar no menu para tentar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживай кнопку выбора и выбери «Обновить» в меню, чтобы повторить попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden denemek için seçme düğmesini basılı tut ve menüden Yenile'yi seç."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住选择按钮，然后从菜单中选择“重新载入”以重试。"
          }
        }
      }
    },
