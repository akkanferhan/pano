    "Swipe on the touch surface: cursor (grows and slows down over links)": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب على سطح اللمس: المؤشر (يكبر ويبطؤ فوق الروابط)"
          }
        },
        "de": {
          "stringUnit": {
