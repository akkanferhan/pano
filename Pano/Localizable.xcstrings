    "From the phone you can send addresses, type text and move the cursor with the touch pad.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من الهاتف يمكنك إرسال العناوين وكتابة النص وتحريك المؤشر باستخدام لوحة اللمس."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vom Telefon aus kannst du Adressen senden, Text eingeben und den Zeiger mit dem Touchpad bewegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde el teléfono puedes enviar direcciones, escribir texto y mover el cursor con el panel táctil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depuis le téléphone, tu peux envoyer des adresses, saisir du texte et déplacer le curseur avec le pavé tactile."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोन से आप पते भेज सकते हैं, टेक्स्ट टाइप कर सकते हैं और टच पैड से कर्सर चला सकते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンからアドレスの送信、テキストの入力、タッチパッドでのカーソル操作ができます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelo celular você pode enviar endereços, digitar texto e mover o cursor com o touch pad."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С телефона можно отправлять адреса, вводить текст и двигать курсор с помощью сенсорной панели."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefondan adres gönderebilir, metin yazabilir ve dokunmatik yüzeyle imleci hareket ettirebilirsin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以从手机发送网址、输入文本，并用触控板移动光标。"
          }
        }
      }
    },
