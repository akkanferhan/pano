    "No connection — is the Apple TV on and on the same network?": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد اتصال — هل Apple TV قيد التشغيل وعلى الشبكة نفسها؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Verbindung — ist das Apple TV eingeschaltet und im selben Netzwerk?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión — ¿está el Apple TV encendido y en la misma red?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de connexion — l’Apple TV est-elle allumée et sur le même réseau ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई कनेक्शन नहीं — क्या Apple TV चालू है और उसी नेटवर्क पर है?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続がありません — Apple TVの電源が入っていて、同じネットワークに接続されていますか？"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conexão — a Apple TV está ligada e na mesma rede?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет подключения — Apple TV включено и в той же сети?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı yok — Apple TV açık ve aynı ağda mı?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无连接 — Apple TV 是否已开启并连接到同一网络？"
          }
        }
      }
    },
    "No favorites yet — add one from the menu while on a site.": {
